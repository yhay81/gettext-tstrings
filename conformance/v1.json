{
  "spec_version": 1,
  "spec": "SPEC.md — The t-string <-> gettext convention (spec v1)",
  "about": [
    "A machine-readable conformance suite for spec v1. An implementation conforms",
    "when it reproduces every case below. Cases exercise only the public contract:",
    "a t-string's static structure in, a msgid or a rendered string out.",
    "",
    "A template is a JSON array of parts. A string part is a literal segment. An",
    "object part is an interpolation with an 'expression' (the text between the",
    "braces), a 'value' (the runtime object), and optional 'conversion' and",
    "'format_spec'. Templates are never evaluated as Python source.",
    "",
    "'error' names the failure class: 'template' for a source t-string this",
    "convention refuses (InvalidTemplateError here), 'translation' for a catalog",
    "pattern it refuses (InvalidTranslationError here)."
  ],

  "msgid_derivation": [
    {"spec": "2", "name": "constant message", "source": ["Hello"], "msgid": "Hello"},
    {"spec": "2", "name": "empty message", "source": [""], "msgid": ""},
    {"spec": "2.2", "name": "single placeholder",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "msgid": "Hello {name}"},
    {"spec": "2.2", "name": "placeholder at the start",
     "source": ["", {"expression": "name", "value": "Ada"}, " wrote this"],
     "msgid": "{name} wrote this"},
    {"spec": "2.2", "name": "adjacent placeholders",
     "source": ["", {"expression": "a", "value": "x"}, "", {"expression": "b", "value": "y"}, ""],
     "msgid": "{a}{b}"},
    {"spec": "2.1", "name": "literal braces are escaped",
     "source": ["Config {raw} is ", {"expression": "value", "value": "on"}],
     "msgid": "Config {{raw}} is {value}"},
    {"spec": "2.1", "name": "lone closing brace is escaped",
     "source": ["end} ", {"expression": "value", "value": "on"}],
     "msgid": "end}} {value}"},
    {"spec": "2.2", "name": "format spec stays out of the msgid",
     "source": ["Total: ", {"expression": "amount", "value": 1234.5, "format_spec": ",.2f"}],
     "msgid": "Total: {amount}"},
    {"spec": "2.2", "name": "conversion stays out of the msgid",
     "source": ["Value ", {"expression": "label", "value": "total", "conversion": "r"}],
     "msgid": "Value {label}"},
    {"spec": "2.2", "name": "conversion and format spec both stay out",
     "source": ["", {"expression": "v", "value": "x", "conversion": "s", "format_spec": ">8"}],
     "msgid": "{v}"},
    {"spec": "2.2", "name": "surrounding whitespace in the expression is stripped",
     "source": ["Hello ", {"expression": " name ", "value": "Ada"}],
     "msgid": "Hello {name}"},
    {"spec": "2.2", "name": "non-ASCII identifiers are accepted",
     "source": ["Hello ", {"expression": "名前", "value": "Ada"}],
     "msgid": "Hello {名前}"},
    {"spec": "2.3", "name": "a name may repeat with identical formatting",
     "source": ["", {"expression": "first", "value": "a"}, ", ",
                {"expression": "second", "value": "b"}, ", ",
                {"expression": "first", "value": "a"}],
     "msgid": "{first}, {second}, {first}"},
    {"spec": "2.3", "name": "a name may not repeat with different formatting",
     "source": ["", {"expression": "amount", "value": 3.5, "format_spec": ".1f"}, " / ",
                {"expression": "amount", "value": 3.5, "format_spec": ".2f"}],
     "error": "template"},
    {"spec": "2.2", "name": "attribute access is rejected",
     "source": ["Hello ", {"expression": "user.name", "value": "Ada"}],
     "error": "template"},
    {"spec": "2.2", "name": "a call is rejected",
     "source": ["Hello ", {"expression": "display_name()", "value": "Ada"}],
     "error": "template"},
    {"spec": "2.2", "name": "subscription is rejected",
     "source": ["Hello ", {"expression": "names[0]", "value": "Ada"}],
     "error": "template"},
    {"spec": "2.2", "name": "an operator expression is rejected",
     "source": ["Total ", {"expression": "a + b", "value": 3}],
     "error": "template"},
    {"spec": "2.2", "name": "a Python keyword is rejected",
     "source": ["", {"expression": "class", "value": "x"}],
     "error": "template"},
    {"spec": "2.2", "name": "a dotted-looking name is rejected",
     "source": ["", {"expression": "a.b.c", "value": "x"}],
     "error": "template"}
  ],

  "plural_msgid_derivation": [
    {"spec": "3", "name": "two msgids, one per branch",
     "singular": ["One file"],
     "plural": ["", {"expression": "n", "value": 3}, " files"],
     "msgids": ["One file", "{n} files"]},
    {"spec": "3", "name": "a shared placeholder may keep identical formatting",
     "singular": ["", {"expression": "n", "value": 1, "format_spec": ",d"}, " file"],
     "plural": ["", {"expression": "n", "value": 3, "format_spec": ",d"}, " files"],
     "msgids": ["{n} file", "{n} files"]},
    {"spec": "3", "name": "a shared placeholder may not change formatting",
     "singular": ["", {"expression": "n", "value": 1, "format_spec": ".1f"}, " file"],
     "plural": ["", {"expression": "n", "value": 3, "format_spec": ".2f"}, " files"],
     "error": "template"}
  ],

  "rendering": [
    {"spec": "5", "name": "identity translation",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name}", "expected": "Hello Ada"},
    {"spec": "5", "name": "constant message",
     "source": ["Hello"], "pattern": "Bonjour", "expected": "Bonjour"},
    {"spec": "4.3", "name": "a translation may reorder placeholders",
     "source": ["", {"expression": "category", "value": "News"}, " to ",
                {"expression": "target", "value": "Archive"}],
     "pattern": "{target} <- {category}", "expected": "Archive <- News"},
    {"spec": "4.3", "name": "a translation may repeat a placeholder",
     "source": ["", {"expression": "name", "value": "Ada"}],
     "pattern": "{name} {name}", "expected": "Ada Ada"},
    {"spec": "5", "name": "the source format spec is applied",
     "source": ["Total: ", {"expression": "amount", "value": 1234.5, "format_spec": ",.2f"}],
     "pattern": "Total: {amount}", "expected": "Total: 1,234.50"},
    {"spec": "5", "name": "the source format spec is applied to a str value",
     "source": ["[", {"expression": "name", "value": "Ada", "format_spec": ">5"}, "]"],
     "pattern": "[{name}]", "expected": "[  Ada]"},
    {"spec": "5", "name": "the source conversion is applied",
     "source": ["Value ", {"expression": "label", "value": "total", "conversion": "r"}],
     "pattern": "Value {label}", "expected": "Value 'total'"},
    {"spec": "5", "name": "conversion runs before the format spec",
     "source": ["", {"expression": "v", "value": "ab", "conversion": "r", "format_spec": ">6"}],
     "pattern": "{v}", "expected": "  'ab'"},
    {"spec": "5", "name": "escaped braces render as literal braces",
     "source": ["Config {raw} is ", {"expression": "value", "value": "on"}],
     "pattern": "Config {{raw}} is {value}", "expected": "Config {raw} is on"},
    {"spec": "5", "name": "a translation may introduce literal braces",
     "source": ["", {"expression": "name", "value": "Ada"}],
     "pattern": "{{{name}}}", "expected": "{Ada}"},
    {"spec": "5", "name": "three placeholders render through the general path",
     "source": ["", {"expression": "a", "value": "1"}, "-", {"expression": "b", "value": "2"},
                "-", {"expression": "c", "value": "3"}],
     "pattern": "{c}-{b}-{a}", "expected": "3-2-1"},

    {"spec": "4.2", "name": "a required placeholder may not be dropped",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello", "error": "translation"},
    {"spec": "4.2", "name": "an unknown placeholder is rejected",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name} {extra}", "error": "translation"},
    {"spec": "4.1", "name": "a translation may not add a conversion",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name!r}", "error": "translation"},
    {"spec": "4.1", "name": "a translation may not add a format spec",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name:>8}", "error": "translation"},
    {"spec": "4.1", "name": "an explicit empty format spec is still a format spec",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name:}", "error": "translation"},
    {"spec": "4.1", "name": "a positional field is rejected",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {0}", "error": "translation"},
    {"spec": "4.1", "name": "an automatic field is rejected",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {}", "error": "translation"},
    {"spec": "4.1", "name": "an attribute field is rejected",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name.__class__}", "error": "translation"},
    {"spec": "4.1", "name": "an index field is rejected",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name[0]}", "error": "translation"},
    {"spec": "4.1", "name": "a name padded with whitespace is rejected",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello { name }", "error": "translation"},
    {"spec": "4.1", "name": "an unterminated field is rejected",
     "source": ["Hello ", {"expression": "name", "value": "Ada"}],
     "pattern": "Hello {name", "error": "translation"}
  ],

  "plural_rendering": [
    {"spec": "5", "name": "n == 1 selects the singular branch",
     "singular": ["One file"],
     "plural": ["", {"expression": "n", "value": 3}, " files"],
     "n": 1, "pattern": "One file", "expected": "One file"},
    {"spec": "5", "name": "n != 1 selects the plural branch",
     "singular": ["One file"],
     "plural": ["", {"expression": "n", "value": 3}, " files"],
     "n": 3, "pattern": "{n} files", "expected": "3 files"},
    {"spec": "5", "name": "a shared placeholder reads the selected branch's value",
     "singular": ["", {"expression": "n", "value": 1}, " file"],
     "plural": ["", {"expression": "n", "value": 7}, " files"],
     "n": 7, "pattern": "{n} files", "expected": "7 files"},
    {"spec": "5", "name": "a shared placeholder reads the singular value when n == 1",
     "singular": ["", {"expression": "n", "value": 1}, " file"],
     "plural": ["", {"expression": "n", "value": 7}, " files"],
     "n": 1, "pattern": "{n} file", "expected": "1 file"},
    {"spec": "4.2", "name": "a branch-only placeholder is available but not required",
     "singular": ["One file"],
     "plural": ["", {"expression": "n", "value": 3}, " files"],
     "n": 3, "pattern": "several files", "expected": "several files"},
    {"spec": "4.2", "name": "a branch-only placeholder may be used in either form",
     "singular": ["One file"],
     "plural": ["", {"expression": "n", "value": 3}, " files"],
     "n": 1, "pattern": "just {n}", "expected": "just 3"},
    {"spec": "4.2", "name": "a placeholder outside the union is still rejected",
     "singular": ["One file"],
     "plural": ["", {"expression": "n", "value": 3}, " files"],
     "n": 3, "pattern": "{other} files", "error": "translation"}
  ]
}
